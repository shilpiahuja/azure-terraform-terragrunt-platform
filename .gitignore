# Ignore local Terraform state and execution directories.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Ignore Terraform variable and backend configuration files.
*.tfvars
*.tfvars.json
environments/*/backend.hcl

# Ignore override files.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore local CLI configuration.
.terraformrc
terraform.rc

# Ignore local Terraform plans and secrets.
*.tfplan
*.pem
*.key
